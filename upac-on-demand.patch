+    let head = '';
+    try { const fd = fs.openSync(src, 'r'); const b = Buffer.alloc(1024); const n = fs.readSync(fd, b, 0, 1024, 0); fs.closeSync(fd); head = sniffAttachment(b.subarray(0, n)) || ''; } catch { /* no type */ }
