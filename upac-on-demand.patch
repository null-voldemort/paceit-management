diff -ruN -x node_modules -x data -x dist orig/src/utils/upacForm.ts p/src/utils/upacForm.ts
--- orig/src/utils/upacForm.ts	1970-01-01 00:00:00.000000000 +0000
+++ p/src/utils/upacForm.ts	2026-10-28 07:43:57.852764001 +0000
@@ -0,0 +1,34 @@
+import { LogEntry } from '../types';
+import { expectsForm } from './forms';
+import { signOut } from './auth';
+
+// The UPAC form is not stored anywhere. The server fills the form template from the connection's own details each
+// time someone downloads it (the same way the Form Maker does), so there is nothing to attach, lose or back up.
+
+/** Connections that have a form (a new user ID, a form request or an EDC number) and enough details to fill it. */
+export function canMakeUpacForm(log: LogEntry): boolean {
+  return expectsForm(log) && Boolean(`${log.customerName || ''}${log.edcNo || ''}${log.nmsId || ''}`.trim());
+}
+
+/** Downloads the UPAC form of a saved connection. Rejects with a readable message when the form cannot be made. */
+export async function downloadUpacForm(log: Pick<LogEntry, 'id' | 'logNo'>): Promise<void> {
+  const res = await fetch(`/api/logs/${encodeURIComponent(log.id)}/upac-form`, { credentials: 'include' });
+  if (!res.ok) {
+    if (res.status === 401) {
+      try { await signOut(); } catch { /* ignore */ }
+    }
+    let msg = `Could not make the UPAC form (${res.status}).`;
+    try { msg = (await res.json()).error || msg; } catch { /* not json */ }
+    throw new Error(msg);
+  }
+  const blob = await res.blob();
+  const filename = decodeURIComponent(res.headers.get('X-Filename') || `UPAC_Form_${log.logNo || log.id}.docx`);
+  const url = URL.createObjectURL(blob);
+  const a = document.createElement('a');
+  a.href = url;
+  a.download = filename;
+  document.body.appendChild(a);
+  a.click();
+  a.remove();
+  setTimeout(() => URL.revokeObjectURL(url), 2000);
+}
