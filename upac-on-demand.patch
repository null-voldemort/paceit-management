+}
+
+/** Fills the template from form fields. Used by the Form Maker (typed values) and by the download on a saved connection. */
+export function renderUpacForm(data: unknown, dateYmd: string): RenderedForm {
+  const fields: FormFields = coerceFormFields(data);
+  if (fields.router_mac) fields.router_mac = normalizeMac(fields.router_mac);
+  const buffer = fillEdcDocx(fields, dateYmd);
+  const baseName = sanitizeFilename(fields.connection_nms || fields.source_no || fields.name || 'form');
+  return { buffer, filename: `${baseName}.docx`, mac: fields.router_mac || '' };
+}
+
+/** Builds the form of a saved connection. Returns null when the record has nothing to identify the form by. */
+export function renderUpacFormForLog(log: UpacSourceLog, now: Date = new Date()): RenderedForm | null {
+  const fields = logToFormFields(log);
+  if (!hasFormContent(fields)) return null;
+  return renderUpacForm(fields, formDateOf(log, now));
+}
